<!DOCTYPE html>
<html lang="bn">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>FF SOJIB GAME SHOP</title>
<style>
*{box-sizing:border-box}
body{margin:0;background:#090d18;color:#fff;font-family:Arial,sans-serif}
header{padding:24px 14px;text-align:center;background:linear-gradient(135deg,#171d35,#40156b);border-bottom:3px solid #ffbd27}
header h1{margin:0;color:#ffca38;font-size:27px}
header p{color:#ddd;margin:10px 0 0}
main{max-width:720px;margin:22px auto;padding:0 14px}
.card{background:#151b2c;border:1px solid #303b59;border-radius:15px;padding:18px;margin-bottom:17px}
h2{font-size:19px;color:#ffcb3e;margin:0 0 15px}
.packages{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}
.package{background:#202942;border:2px solid #3a4766;border-radius:12px;color:#fff;padding:16px 6px;cursor:pointer;font-size:15px}
.package strong{display:block;color:#ffce42;font-size:18px;margin-bottom:7px}
.package.selected{border-color:#ffca38;background:#40331c}
label{display:block;margin:13px 0 7px;color:#e4e8f2}
input,select{width:100%;padding:13px;border-radius:8px;border:1px solid #495570;background:#0c1220;color:#fff;font-size:16px}
button.submit{width:100%;margin-top:18px;padding:15px;border:0;border-radius:9px;background:#ffca38;color:#171717;font-size:17px;font-weight:bold;cursor:pointer}
.note{font-size:13px;line-height:1.6;color:#bdc7db}
footer{text-align:center;color:#aab2c5;padding:20px;font-size:13px}
</style>
</head>
<body>
<header>
<h1>🔥 FF SOJIB GAME SHOP</h1>
<p>Free Fire Diamond Top-Up</p>
</header>
<main>
<section class="card">
<h2>💎 ডায়মন্ড প্যাকেজ বেছে নাও</h2>
<div class="packages" id="packages"></div>
</section>
<section class="card">
<h2>🛒 অর্ডারের তথ্য</h2>
<form id="orderForm">
<label for="uid">Free Fire Player UID</label>
<input id="uid" inputmode="numeric" placeholder="তোমার Player UID লিখো" required>
<label for="player">তোমার নাম (ঐচ্ছিক)</label>
<input id="player" placeholder="নাম লিখো">
<label for="payment">পেমেন্ট পদ্ধতি</label>
<select id="payment" required>
<option value="">পেমেন্ট পদ্ধতি বেছে নাও</option>
<option>bKash</option>
<option>Nagad</option>
<option>Rocket</option>
</select>
<label for="trx">Transaction ID (পেমেন্ট করলে)</label>
<input id="trx" placeholder="TrxID লিখো">
<button class="submit" type="submit">অর্ডারের তথ্য তৈরি করো</button>
</form>
<p class="note">এটি বর্তমানে ডেমো অর্ডার ফর্ম। অর্ডার এখানে সংরক্ষিত বা পেমেন্ট যাচাই হয় না। পেমেন্ট করার আগে দোকানের মালিকের সঙ্গে নিশ্চিত হও।</p>
</section>
<section class="card">
<h2>📞 যোগাযোগ</h2>
<p>অর্ডার বা পেমেন্টের সাহায্যের জন্য দোকানের মালিকের সঙ্গে যোগাযোগ করো।</p>
<p class="note">তোমার যাচাই করা যোগাযোগ নম্বর এখানে পরে যোগ করা যাবে।</p>
</section>
</main>
<footer>© FF SOJIB GAME SHOP</footer>
<script>
const items=[
 {diamonds:25,price:20},
 {diamonds:50,price:ট},
 {diamonds:115,price:ট},
 {diamonds:240,price:ট},
 {diamonds:610,price:ট},
 {diamonds:1240,price:ট}
];
let chosen=null;
const area=document.getElementById('packages');
items.forEach((item,i)=>{
 const b=document.createElement('button');
 b.type='button';b.className='package';
 b.innerHTML='<strong>💎 '+item.diamonds+' Diamonds</strong>দাম: ৳'+item.price;
 b.onclick=()=>{
  chosen=item;
  document.querySelectorAll('.package').forEach(x=>x.classList.remove('selected'));
  b.classList.add('selected');
 };
 area.appendChild(b);
});
document.getElementById('orderForm').addEventListener('submit',e=>{
 e.preventDefault();
 if(!chosen){alert('আগে একটি ডায়মন্ড প্যাকেজ বেছে নাও।');return;}
 const uid=document.getElementById('uid').value.trim();
 if(!/^[0-9]{5,20}$/.test(uid)){alert('সঠিক Player UID লিখো (৫–২০টি সংখ্যা)।');return;}
 const msg='FF SOJIB GAME SHOP — ডেমো অর্ডার\\nপ্যাকেজ: '+chosen.diamonds+' Diamonds\\nদাম: ৳'+chosen.price+'\\nPlayer UID: '+uid+'\\nনাম: '+document.getElementById('player').value+'\\nপেমেন্ট: '+document.getElementById('payment').value+'\\nTrxID: '+document.getElementById('trx').value+'\\n\\nএটি শুধু অর্ডারের খসড়া; পেমেন্ট বা ডেলিভারি নিশ্চিত নয়।';
 alert(msg);
});
</script>
</body>
</html>
